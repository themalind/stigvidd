<Project>
  <PropertyGroup>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <MeziantouAnalysisMode>None</MeziantouAnalysisMode>
  </PropertyGroup>

  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.324">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Licence and copyright, compiled into every assembly's metadata so a built
       DLL carries the same answer the source tree does. The backend is AGPL:
       it is network server software, which is the case that licence exists for.
       The mobile app in app/ is MPL-2.0 instead - see app/LICENSE.md. -->
  <PropertyGroup>
    <Copyright>Copyright (C) 2025-2026 The Stigvidd Authors</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Authors>The Stigvidd Authors</Authors>
    <Product>Stigvidd</Product>
  </PropertyGroup>
</Project>
