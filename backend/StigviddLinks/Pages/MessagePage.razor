<Document Title="@Heading" Description="@Body" SiteUrl="@SiteUrl">
    <div class="content">
        <h1>@Heading</h1>
        <p class="description">@Body</p>
        <div class="actions">
            <a class="button primary" href="@SiteUrl">Till stigvidd.se</a>
        </div>
    </div>
</Document>

@code {
    [Parameter, EditorRequired] public required string Heading { get; set; }
    [Parameter, EditorRequired] public required string Body { get; set; }
    [Parameter, EditorRequired] public required string SiteUrl { get; set; }
}
