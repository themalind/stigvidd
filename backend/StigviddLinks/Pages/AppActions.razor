<div class="actions">
    <a class="button primary" href="@AppUrl">@Texts.OpenInApp</a>
    @if (!IsAndroid && !string.IsNullOrWhiteSpace(Options.AppStoreUrl))
    {
        <a class="button" href="@Options.AppStoreUrl">@Texts.AppStore</a>
    }
    @if (!string.IsNullOrWhiteSpace(Options.PlayStoreUrl))
    {
        <a class="button" href="@Options.PlayStoreUrl">@Texts.GooglePlay</a>
    }
    else if (OffersAndroidTest)
    {
        <a class="button" href="@Options.AndroidTestUrl">@Texts.AndroidTest</a>
    }
</div>
<p class="hint">@(OffersAndroidTest ? Texts.AndroidTestHint : Texts.GetTheAppHint)</p>

@code {
    [Parameter, EditorRequired] public required string AppUrl { get; set; }
    [Parameter, EditorRequired] public required AppLinksOptions Options { get; set; }
    [Parameter, EditorRequired] public required PageTexts Texts { get; set; }
    [Parameter] public bool IsAndroid { get; set; }

    private bool OffersAndroidTest =>
        IsAndroid && string.IsNullOrWhiteSpace(Options.PlayStoreUrl) && !string.IsNullOrWhiteSpace(Options.AndroidTestUrl);
}
