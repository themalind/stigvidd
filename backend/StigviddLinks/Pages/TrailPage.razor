<Document Title="@Name"
          Description="@Summary"
          SiteUrl="@Options.SiteUrl"
          CanonicalUrl="@CanonicalUrl"
          ImageUrl="@Image?.ImageUrl"
          Texts="@Texts"
          CurrentPath="@TrailPath">
    @if (Image is not null)
    {
        <img class="hero" src="@Image.ImageUrl" alt="@(Image.AltText ?? Name)" />
    }
    <div class="content">
        <h1>@Name</h1>
        @if (Facts.Length > 0)
        {
            <p class="facts">@Facts</p>
        }
        @if (!string.IsNullOrWhiteSpace(Trail.Description))
        {
            <p class="description">@Trail.Description</p>
        }
        <AppActions AppUrl="@AppUrl" Options="@Options" Texts="@Texts" IsAndroid="@IsAndroid" />
    </div>
</Document>

@code {
    private const int SummaryLength = 200;

    [Parameter, EditorRequired] public required TrailResponse Trail { get; set; }
    [Parameter, EditorRequired] public required AppLinksOptions Options { get; set; }
    [Parameter, EditorRequired] public required PageTexts Texts { get; set; }
    [Parameter] public bool IsAndroid { get; set; }

    private string Name => string.IsNullOrWhiteSpace(Trail.Name) ? Texts.FallbackTrailName : Trail.Name;

    private TrailImageResponse? Image => Trail.TrailImagesResponse?.FirstOrDefault();

    private string TrailPath => $"/trail/{Uri.EscapeDataString(Trail.Identifier)}";

    private string CanonicalUrl =>
        $"{Options.PublicBaseUrl.TrimEnd('/')}{TrailPath}{(Texts == PageTexts.Swedish ? "" : $"?lang={Texts.Code}")}";

    private string AppUrl => $"{Options.AppScheme}://trail/{Uri.EscapeDataString(Trail.Identifier)}";

    private string Facts => string.Join(" · ", new[]
    {
        Trail.TrailLength is { } length ? $"{length.ToString("0.#", Texts.Culture)} km" : null,
        Trail.City,
    }.Where(part => !string.IsNullOrWhiteSpace(part)));

    private string Summary
    {
        get
        {
            var text = string.IsNullOrWhiteSpace(Trail.Description) ? Facts : Trail.Description.Trim();
            return text.Length <= SummaryLength ? text : $"{text[..(SummaryLength - 1)].TrimEnd()}…";
        }
    }
}
