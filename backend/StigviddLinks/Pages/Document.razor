<!doctype html>
<html lang="@Texts.Code">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Title – Stigvidd</title>
    <meta name="description" content="@Description" />
    <link rel="icon" href="@IconUrl" />
    @if (CanonicalUrl is not null)
    {
        <link rel="canonical" href="@CanonicalUrl" />
        <meta property="og:url" content="@CanonicalUrl" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stigvidd" />
    <meta property="og:locale" content="@Texts.OgLocale" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:image" content="@(ImageUrl ?? IconUrl)" />
    <meta name="twitter:card" content="@(ImageUrl is null ? "summary" : "summary_large_image")" />
    <style>
        :root {
            color-scheme: light dark;
            --bg: hsl(180, 12%, 94%);
            --surface: rgb(252, 254, 254);
            --text: rgb(22, 28, 30);
            --muted: rgb(60, 70, 72);
            --accent: hsl(195, 65%, 22%);
            --on-accent: rgb(255, 255, 255);
            --border: rgb(204, 214, 214);
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: hsl(220, 35%, 6%);
                --surface: hsl(220, 28%, 10%);
                --text: rgb(224, 230, 242);
                --muted: rgb(196, 204, 222);
                --accent: hsl(212, 70%, 75%);
                --on-accent: rgb(0, 32, 70);
                --border: rgb(58, 64, 78);
            }
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 16px;
            background: var(--bg);
            color: var(--text);
            font: 17px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            -webkit-text-size-adjust: 100%;
        }

        main {
            max-width: 32rem;
            margin: 0 auto;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 5px;
            overflow: hidden;
        }

        .hero { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
        .content { padding: 20px; }
        h1 { font-size: 1.5rem; line-height: 1.25; margin: 0 0 6px; }
        .facts { margin: 0 0 14px; color: var(--muted); }
        .description { margin: 0 0 20px; }
        .actions { display: flex; flex-direction: column; gap: 10px; }

        .button {
            display: block;
            padding: 12px 16px;
            border-radius: 5px;
            border: 1px solid var(--accent);
            text-align: center;
            text-decoration: none;
            font-weight: 600;
            color: var(--accent);
        }

        .button.primary { background: var(--accent); color: var(--on-accent); }
        .hint { margin: 10px 0 0; font-size: 0.9rem; color: var(--muted); text-align: center; }
        .lang { max-width: 32rem; margin: 0 auto 10px; text-align: right; font-size: 0.9rem; }
        .lang a { color: var(--muted); }
        footer { max-width: 32rem; margin: 16px auto 0; text-align: center; font-size: 0.9rem; }
        footer a { color: var(--muted); }
    </style>
</head>
<body>
    <nav class="lang">
        <a href="@($"{CurrentPath}?lang={Texts.SwitchToCode}")" hreflang="@Texts.SwitchToCode" lang="@Texts.SwitchToCode">@Texts.SwitchToLabel</a>
    </nav>
    <main>
        @ChildContent
    </main>
    <footer>
        <a href="@SiteUrl">stigvidd.se</a>
    </footer>
</body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string SiteUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public required PageTexts Texts { get; set; }
    [Parameter, EditorRequired] public required string CurrentPath { get; set; }
    [Parameter] public string? CanonicalUrl { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string IconUrl => $"{SiteUrl.TrimEnd('/')}/icon.png";
}
