{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Npgsql": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "PresentableBaseUrl": "https://media.stigvidd.se/",
  "ObstacleRetention": {
    "Days": 30,
    "SolvedVotesToHide": 3,
    "CleanupIntervalHours": 24
  },
  "Keycloak": {
    "realm": "stigvidd",
    "ssl-required": "true",
    "resource": "stigvidd-api",
    "verify-token-audience": true
  },  
  "KeycloakAdminClient": {
    "realm": "stigvidd",
    "ssl-required": "true",
    "resource": "stigvidd-admin-api"
  }
}