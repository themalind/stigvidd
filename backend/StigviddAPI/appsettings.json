{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication.JwtBearer": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Npgsql": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "PresentableBaseUrl": "https://media.stigvidd.se/",
  "Authorization": {
    "AdminRole": "stigvidd-admin"
  },
  "DataTransfer": {
    "SharedServices": false
  },
  "ObstacleRetention": {
    "Days": 30,
    "SolvedVotesToHide": 3,
    "CleanupIntervalHours": 24
  },
  "ContentReports": {
    "MaxReportsPerUserPerDay": 5,
    "DismissedReportsBeforeHideIsWithheld": 3,
    "SnapshotMaxLength": 2000
  },
  "MailOutbox": {
    "MaxAttempts": 5,
    "DefaultLanguage": "sv",
    "SentRetentionDays": 7,
    "SettledRetentionDays": 30,
    "BodyRetentionHours": 24,
    "CleanupIntervalHours": 1
  },
  "ContributionRanking": {
    "HalfLifeDays": 180,
    "Z": 1.96,
    "LikeBonusWeight": 0.05,
    "Take": 10,
    "CacheMinutes": 10
  },
  "CommunityTrails": {
    "PlaceholderImagePaths": [ "mock/vindskydd_mock.jpg" ]
  },
  "MediaReprocess": {
    "SettledRetentionDays": 30,
    "CleanupIntervalHours": 1
  },
  "EmailVerification": {
    "TokenLifetimeHours": 24,
    "ResendCooldownSeconds": 60,
    "MaxCodeAttempts": 5
  },
  "PasswordReset": {
    "TokenLifetimeHours": 2,
    "ResendCooldownSeconds": 60
  },
  "Keycloak": {
    "realm": "stigvidd",
    "ssl-required": "true",
    "resource": "stigvidd-api",
    "verify-token-audience": true
  },  
  "KeycloakAdminClient": {
    "realm": "stigvidd",
    "ssl-required": "true",
    "resource": "stigvidd-admin-api"
  }
}
