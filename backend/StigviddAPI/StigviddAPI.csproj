<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bd360075-11d4-4b3b-bfb7-58fe203f2787</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Duende.AccessTokenManagement" Version="4.2.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Keycloak.AuthServices.Authentication" Version="3.0.0" />
    <PackageReference Include="Keycloak.AuthServices.Sdk" Version="3.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- pinned above the 2.0.0 that Microsoft.AspNetCore.OpenApi resolves: GHSA-v5pm-xwqc-g5wc -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <!-- Telemetry. Registered only when Otlp:Endpoint is configured; see
         Extensions/TelemetryExtensions.cs. Npgsql 10 emits its own "Npgsql"
         ActivitySource and Meter, so AddSource("Npgsql") covers the database and
         no Npgsql.OpenTelemetry shim is needed. EntityFrameworkCore
         instrumentation is deliberately absent: it ships prerelease only. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
    <PackageReference Include="NSwag.Core" Version="14.7.1" />
    <PackageReference Include="NSwag.Generation" Version="14.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\WebDataContracts\WebDataContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Refreshes web/openapi.json after every Debug build, by running the freshly built
    assembly with the export-openapi switch Program.cs handles (ReadOpenApiExportPath).

    This is what makes the API contract current on an ORDINARY build - `dotnet build`, the
    VS Code "build api" task, and F5 (which runs that task first). Before this, the document
    was written by an integration test, so it only moved when someone ran the backend suite,
    and the first sign of a stale client was a red Jenkins build.

    Every condition below is load-bearing:

      Configuration == Debug   backend/Dockerfile publishes in Release with build context
                               ./backend, where neither ../web nor ../scripts exists.
      DesignTimeBuild          the C# Dev Kit runs design-time builds constantly while you
                               type. Without this the editor would boot the API host on
                               every one of them.
      Exists(...)              any other context holding only backend/.
      StigviddSkipApiCodegen   the explicit escape hatch: -p:StigviddSkipApiCodegen=true.

    Inputs/Outputs make it incremental: MSBuild skips the target entirely while
    web/openapi.json is newer than the assembly, so a no-op rebuild costs nothing. The
    script always writes the file for exactly this reason.

    ContinueOnError="true" is MSBuild's synonym for WarnAndContinue, spelled the way the
    editor's schema recognises. It is deliberate: failing to produce a document must never
    fail the build - that would turn a backend compile into a red build over the other
    area's artifact. The Jenkinsfile Preflight asserts the file exists instead, which is
    where it matters.
  -->
  <Target Name="GenerateOpenApiSpec"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug'
                 And '$(DesignTimeBuild)' != 'true'
                 And '$(StigviddSkipApiCodegen)' != 'true'
                 And Exists('$(MSBuildProjectDirectory)/../../scripts/generate-openapi.mjs')"
          Inputs="$(TargetPath)"
          Outputs="$(MSBuildProjectDirectory)/../../web/openapi.json">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../scripts/generate-openapi.mjs&quot; --quiet"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ContinueOnError="true" />
  </Target>

</Project>
