{
  "name": "stigvidd",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MPL-2.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "publish:preview": "node scripts/publish-update.mjs preview",
    "publish:production": "node scripts/publish-update.mjs production",
    "test:scripts": "node --test scripts/publish-checks.test.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@maplibre/maplibre-react-native|jotai|standard-navigation|@miblanchard/react-native-slider)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@expo/vector-icons/(.*)$": "<rootDir>/__mocks__/@expo/vector-icons-subpath.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/scripts/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.after-env.js"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^7.0.5",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/geojson": "^7946.0.16",
    "axios": "1.21.1",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.21",
    "geolib": "^4.0.2",
    "i18next": "^27.0.1",
    "jotai": "^3.0.2",
    "jotai-tanstack-query": "^0.11.0",
    "jwt-decode": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.66.0",
    "react-i18next": "^18.0.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-aware-scroll-view": "0.9.5",
    "react-native-paper": "^5.14.5",
    "react-native-paper-dates": "0.24.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-star-rating-widget": "^1.10.0",
    "react-native-svg": "15.16.0",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "private": true
}
