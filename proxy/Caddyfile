# Caddy reverse proxy with automatic Let's Encrypt certificates.
# Domains and ACME contact come from the environment (set in .env); Caddy
# substitutes {$VAR} at load time. Each site block gets its own auto-renewed
# certificate over HTTP-01/TLS-ALPN on ports 80/443.

{
	email {$ACME_EMAIL}
	# Default is Let's Encrypt production. To avoid rate limits while testing,
	# set ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

# Web frontend.
{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
}

# Backend API.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}

# Keycloak (identity provider). Passes X-Forwarded-* so Keycloak builds correct
# public URLs (it's configured with KC_PROXY_HEADERS=xforwarded).
{$AUTH_DOMAIN} {
	encode zstd gzip
	reverse_proxy keycloak:8080
}

# Media (own subdomain — swap for a CDN origin later without touching the app).
# Public GETs are served; write methods still require the basic auth only the
# API holds (and the API uploads over the internal network, not through here).
{$MEDIA_DOMAIN} {
	encode zstd gzip
	reverse_proxy media:80
}

# Telemetry (OpenObserve): UI, OTLP ingest and RUM on one subdomain. The mobile
# apps post here straight from the public internet, so unlike every other block
# this one is a WRITE endpoint for untrusted clients — the RUM client token that
# authorises them ships inside a mobile binary and is therefore public. The
# mitigations are the ingest-only scope of that token, the retention caps, and
# the request-size limit below. See DEPLOYMENT.md.
#
# Deliberately no `log` directive: ingest arrives at whatever rate the fleet
# decides, and access-logging it would drown the proxy's stderr and, through
# docker's json-file driver, the host disk.
{$OBSERVATORY_DOMAIN} {
	# Cap what a single request can push. OpenObserve itself accepts arbitrarily
	# large OTLP batches. 10MB is far above any real batch.
	request_body {
		max_size 10MB
	}

	# Ingest replies are a few dozen bytes of JSON at high rate — compressing them
	# is pure CPU. The UI bundle is megabytes and very much worth compressing, so
	# `encode` is scoped to everything that is NOT ingest. (Note `encode` only ever
	# compresses RESPONSES, so this is an efficiency split, not a correctness one.)
	# Caddy path matching uses Go's path.Match, where `*` does not cross `/`. So the
	# per-stream ingest endpoint /api/<org>/<stream>/_json needs its own two-segment
	# pattern; /api/*/_bulk is org-level and correct with one.
	#
	# /rum/* crosses slashes, but only because Caddy fast-paths a pattern whose ONLY
	# wildcard is a trailing `*` into a plain prefix match. That shortcut does not
	# apply to /api/*/v1/*, where the interior `*` forces real path.Match — so its
	# trailing `*` matches exactly one segment. Fine for /api/<org>/v1/logs, but a
	# deeper ingest path would need its own pattern. Verified against caddy:2-alpine.
	@ingest path /api/*/v1/* /api/*/_json /api/*/*/_json /api/*/_bulk /rum/*
	handle @ingest {
		reverse_proxy openobserve:5080
	}

	# Everything else: the UI. reverse_proxy upgrades WebSockets transparently,
	# which is what the live-tail/search stream needs, and Caddy has no default
	# response timeout — do not add one, it would truncate live tail.
	handle {
		encode zstd gzip
		reverse_proxy openobserve:5080
	}
}

# Mail server hostname. Nothing is proxied here — SMTP and IMAP are served
# directly by the `mailserver` container on ports 25/465/587/993. This block
# exists solely so Caddy obtains and auto-renews the certificate for this name,
# which the mail server reads out of the shared caddy_data volume for its own
# TLS. Removing it silently breaks mail TLS at the next renewal.
{$MAIL_DOMAIN} {
	respond "Stigvidd mail server" 200
}
