# Copy to `.env` and fill in. `.env` is git-ignored.
# Read automatically by `docker compose`.

# ---- Images (CI / deploy) ------------------------------------------------
# Registry namespace and tag for the api/web images. CI sets these when it
# builds & pushes; the deploy host sets them (or inherits from Jenkins) to pull
# the right tag. Left at defaults, `docker compose up --build` builds locally.
REGISTRY=inkaben.se
IMAGE_TAG=latest

# ---- Domains / TLS (Caddy reverse proxy) ---------------------------------
# Each must have a DNS A/AAAA record pointing at THIS host, with ports 80 & 443
# reachable, before Caddy can obtain Let's Encrypt certificates.
WEB_DOMAIN=stigvidd.se
API_DOMAIN=api.stigvidd.se
MEDIA_DOMAIN=media.stigvidd.se
AUTH_DOMAIN=auth.stigvidd.se
# ACME contact address (expiry/renewal notices from Let's Encrypt).
ACME_EMAIL=admin@stigvidd.se
# While testing, use LE staging to avoid rate limits (certs won't be trusted):
#   ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# NOTE: the mailserver's SSL_CERT_PATH in docker-compose.yml hard-codes the
# PRODUCTION issuer directory name. Switch to staging and that path must change
# to `acme-staging-v02...` too, or the mail server won't start.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# ---- Mail (docker-mailserver + Hostup smarthost) -------------------------
# Public hostname of the mail server. Needs its own A record on this host, an MX
# record on the bare domain pointing at it, and SPF/DKIM/DMARC — see the DNS
# table in DEPLOYMENT.md. Caddy issues its TLS certificate.
MAIL_DOMAIN=mail.stigvidd.se
# Hostup's smarthost: outbound port 25 is blocked on their VPSes, so all mail
# leaves through this relay. It authorises by SOURCE IP via the
# `_hostup.stigvidd.se` TXT record — there is deliberately no username/password.
MAIL_RELAY_HOST=relay.hostup.se
MAIL_RELAY_PORT=587
POSTMASTER_ADDRESS=postmaster@stigvidd.se
TZ=Europe/Stockholm
# The mailbox Keycloak (and later the API) authenticates as to submit mail on
# 587. Create it on the host with
#   docker compose exec mailserver setup email add no-reply@stigvidd.se
# and set the SAME password here and in Keycloak's realm email settings.
SMTP_NOREPLY_USER=no-reply@stigvidd.se
SMTP_NOREPLY_PASSWORD=change-me-to-a-strong-secret

# ---- Database ------------------------------------------------------------
POSTGRES_DB=stigvidd
POSTGRES_USER=stigvidd
POSTGRES_PASSWORD=change-me-to-a-strong-secret

# ---- Keycloak (identity provider) ----------------------------------------
# Public issuer URL (served by the proxy at AUTH_DOMAIN). Used by the API and
# web as the OIDC authority; must be the PUBLIC URL, no trailing slash.
KEYCLOAK_URL=https://auth.stigvidd.se
# Keycloak's own database inside the app Postgres instance.
KEYCLOAK_DB=keycloak
# First-boot admin account for the Keycloak master realm (console login).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-to-a-strong-secret

# ---- Observability (OpenObserve) -----------------------------------------
# Telemetry store at its own subdomain, served by the proxy. Needs its own A
# record on this host before Caddy can obtain a certificate — and note that an
# EMPTY value here makes Caddy refuse to load its whole config, taking every
# other domain down with it, so never leave it blank.
OBSERVATORY_DOMAIN=observatory.stigvidd.se
# First-boot root account for the OpenObserve UI. Created only while the data
# volume is empty — changing these later has no effect, rotate in the UI. This
# password is full admin over all telemetry AND the ingest credentials, and
# telemetry contains personal data, so treat it like KC_ADMIN_PASSWORD.
#
# OpenObserve ENFORCES a password policy and PANICS ON STARTUP if it is not met:
# 8-128 characters with at least one lowercase, one uppercase, one digit and one
# special character. A weak value here does not warn — the container crashes with
# "backend job init failed" and never binds a port.
OBSERVATORY_ROOT_EMAIL=admin@stigvidd.se
OBSERVATORY_ROOT_PASSWORD=Change-Me-To-A-Strong-Secret#1
# Organisation the API and the apps write into. `default` is created on first
# boot; changing it means creating the org in the UI first.
OBSERVATORY_ORG=default
# GLOBAL retention default, in days — the only one OpenObserve has. This is the
# logs-and-traces policy; metrics are kept far longer via per-stream overrides
# applied by scripts/observatory-retention.sh. Deliberately low: anything not
# explicitly overridden fails safe towards a small disk, and this is also what
# bounds how long personal data lives. Upstream default is 3650 (!); minimum 3.
OBSERVATORY_RETENTION_DAYS=7
# Retention for metrics streams, applied as a per-stream override. Two years.
# Lawful only because metrics carry NO personal data — see docs/observability.md
OBSERVATORY_METRICS_RETENTION_DAYS=730

# ---- Backend telemetry export (optional) ---------------------------------
# OPT-IN. Leave OTLP_ENDPOINT unset and the API registers no OpenTelemetry
# providers at all — nothing breaks when observability is absent or down.
#
# In-stack plaintext: `openobserve` resolves on the `public` docker network, so
# this needs no TLS and no proxy hop. No signal path — the exporter appends
# /v1/logs, /v1/traces and /v1/metrics itself.
OTLP_ENDPOINT=http://openobserve:5080/api/default
# Dedicated ingest user created in the OpenObserve UI. NOT the root account.
OTLP_USER=ingest@stigvidd.se
# SECRET. Kept as a readable password rather than a pre-encoded base64 blob —
# the header is built in code, which also sidesteps a .NET SDK bug where
# OTEL_EXPORTER_OTLP_HEADERS values are not URL-decoded.
OTLP_PASSWORD=change-me-to-a-strong-secret
OTLP_LOG_STREAM=stigvidd_api_logs

# The mobile apps' telemetry config (RUM application id + client token) is NOT
# set here — the app is built by EAS, not by this compose file. Those values
# ship inside the installed binary and are therefore PUBLIC; see app/README.

# ---- Backend API ---------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# ---- Media / WebDAV ------------------------------------------------------
# Credentials the API uses to upload to the media server (basic auth on writes;
# reads are public). Set both; they must match on api and media.
WEBDAV_USER=stigvidd
WEBDAV_PASSWORD=change-me-to-a-strong-secret
# Public base URL the API hands to clients so they can READ images (the media
# subdomain, served over TLS by the proxy). Keep the trailing slash.
PRESENTABLE_BASE_URL=https://media.stigvidd.se/

# ---- Web frontend --------------------------------------------------------
# Baked into the JS bundle at build time. Now a stable public URL, so the same
# image works on every host (no more per-host rebuilds).
# Change any of these -> rebuild the web image: `docker compose up -d --build web`
VITE_API_URL=https://api.stigvidd.se
VITE_OIDC_URL=https://auth.stigvidd.se
VITE_OIDC_REALM=stigvidd
VITE_CLIENT_ID=stigvidd-admin
