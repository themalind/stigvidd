# Throwaway values for `docker compose build` in CI.
#
# docker compose interpolates the WHOLE file before it does anything, so the
# required `${VAR:?...}` refs on db/api/media/proxy/keycloak/openobserve must
# resolve even though a build touches none of those services. NOTHING here is
# baked into an image or deployed — api/web/media read their real values from
# the persistent .env on the deploy host at runtime.
#
# Real environment variables take precedence over this file, which is how
# REGISTRY / IMAGE_TAG / VITE_* get their actual values from the pipeline.

POSTGRES_PASSWORD=ci-build-not-used
WEBDAV_USER=ci
WEBDAV_PASSWORD=ci-build-not-used
PRESENTABLE_BASE_URL=http://ci-not-used/
WEB_DOMAIN=ci
API_DOMAIN=ci
MEDIA_DOMAIN=ci
AUTH_DOMAIN=ci
MAIL_DOMAIN=ci
ACME_EMAIL=ci@ci
KEYCLOAK_URL=http://ci-not-used
KC_ADMIN_USER=ci
KC_ADMIN_PASSWORD=ci-build-not-used

# Observability. Only the `:?`-required refs need placeholders here — the
# OTLP_* vars are `${VAR:-}` soft refs that interpolate to empty without error.
OBSERVATORY_DOMAIN=ci
OBSERVATORY_ROOT_EMAIL=ci@ci
OBSERVATORY_ROOT_PASSWORD=ci-build-not-used
